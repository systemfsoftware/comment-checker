#!/usr/bin/env bash
# Portable native-binary wrapper. Copy to bin/<tool> and set TOOL below.
# Resolves whichever @<scope>/<platform> package pnpm installed for THIS host,
# so the same committed script works on linux-glibc, linux-musl, darwin, and win32.
set -euo pipefail

TOOL="dprint"
SCOPE="@dprint"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for candidate in "$ROOT/node_modules/$SCOPE"/*/"$TOOL" "$ROOT/node_modules/$SCOPE"/*/"$TOOL.exe"; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

echo "error: no $TOOL binary under $ROOT/node_modules/$SCOPE/*/" >&2
echo "install the $SCOPE platform package for this host (see references/build-permissions.md)" >&2
exit 1
