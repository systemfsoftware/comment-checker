{
  "name": "claude-code-comment-checker",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "prepare": "husky",
    "mutants": "cargo mutants --file crates/comment-checker/src/classify.rs --timeout 90",
    "gate:mutants": "turbo run //#mutants"
  },
  "devDependencies": {
    "@effect/tsgo": "latest",
    "@systemfsoftware/tsconfig": "^2.0.1",
    "husky": "^9.1.7",
    "tsdown": "latest",
    "turbo": "^2.11.5",
    "typescript": "latest"
  }
}
