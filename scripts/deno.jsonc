{
  "imports": {
    "@effect/platform-deno": "npm:@effect/platform-deno@4.0.0-rc.118",
    "@libs/diff": "jsr:@libs/diff@4.0.1",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/toml": "jsr:@std/toml@1.0.11",
    "@std/yaml": "jsr:@std/yaml@1.3.0",
    "arktype": "npm:arktype@2.2.5",
    "effect": "npm:effect@4.0.0-rc.118"
  },
  "tasks": {
    "manifest:generate": "./tools/generate-platform-manifest.ts",
    "check-matrix": "./tools/check-matrix.ts",
    "lint": "deno lint --config ./deno.jsonc .",
    "lint:workflows": "./tools/lint-workflows.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": false
  }
}
